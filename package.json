{
  "name": "xecute-labs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n app,python \"next dev --hostname 127.0.0.1\" \"node runner/server.mjs\"",
    "build": "next build",
    "start": "concurrently -k -n app,python \"next start --hostname 127.0.0.1\" \"node runner/server.mjs\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "lucide-react": "1.43.0",
    "next": "16.3.4",
    "pyodide": "0.29.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "concurrently": "10.0.5",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
